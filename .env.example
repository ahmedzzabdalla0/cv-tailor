# Required
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional model tuning
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=120

# Pipeline behaviour
BATCH_SIZE=3
MAX_DESCRIPTION_CHARS=6000
MAX_PROJECTS=3
GUARD_RETRY_LIMIT=1

# Delivery: local | telegram | both
DELIVERY=local
OUTPUT_DIR=out

# Master CV: MASTER_CV_JSON (inline JSON) overrides MASTER_CV_PATH
MASTER_CV_PATH=data/master_cv.json
MASTER_CV_JSON=

# Jobs: JOBS_JSON (inline JSON) overrides the --jobs-file flag
JOBS_JSON=

# Required only when DELIVERY includes telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
